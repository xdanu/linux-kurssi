#!/bin/bash

				kaytetty50=50
                                if [ "$kaytetty50" -lt 80 ]; then
                                        tila50="Ok"
                                else
                                        tila50="Warning"
				fi
                                kaytetty80=80
                                if [ "$kaytetty80" -lt 80 ]; then
                                        tila80="Ok"
                                else
                                        tila80="Warning"
				fi
                                kaytetty90=90
                                if [ "$kaytetty90" -lt 80 ]; then
                                        tila90="Ok"
                                else
                                        tila90="Warning"
				fi


